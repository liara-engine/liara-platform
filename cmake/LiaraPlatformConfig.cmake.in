@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(LiaraInterfaces)
# Private to the module, but a static liara_platform carries it into its consumers' link line.
find_dependency(SDL3)

include("${CMAKE_CURRENT_LIST_DIR}/LiaraPlatformTargets.cmake")

check_required_components(LiaraPlatform)